# ============================================================
# Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- LLM Configuration ---
# Required: at least one LLM provider
OPENAI_API_KEY=sk-your-openai-key-here
# ANHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Model settings
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
MAX_TOKENS=4096

# --- Data Sources ---

# Tavily API for news search (https://tavily.com)
TAVILY_API_KEY=tvly-your-tavily-key-here

# SEC EDGAR settings (required by SEC)
# Must include your email; see https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="Financial Research Agent/1.0 (your@email.com)"

# Alpha Vantage (optional, for additional data)
# ALPHA_VANTAGE_KEY=your-key-here

# --- Storage ---

# Vector database path (for RAG)
VECTOR_DB_PATH=./data/vectorstore

# Cache settings
CACHE_DIR=./data/cache
CACHE_TTL=3600

# Report output
OUTPUT_DIR=./data/reports

# --- Research Settings ---

# Research depth: quick | standard | deep
RESEARCH_DEPTH=standard

# Report format: markdown | json
REPORT_FORMAT=markdown

# Number of news articles to analyze
NEWS_MAX_ARTICLES=10

# Technical analysis lookback period (days)
TECHNICAL_LOOKBACK_DAYS=180

# --- Web UI ---
STREAMLIT_SERVER_PORT=8501
